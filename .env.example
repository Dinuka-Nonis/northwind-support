# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section".
#
# Running the API from source (npm run api): this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server
# elsewhere, or on another port.
#
# Running the API in Docker (docker compose up): the container builds its own connection string
# from MSSQL_SA_PASSWORD above, and reaches SQL Server by its service name (sqlserver). The
# localhost address below is for the API on your machine, so it is not used by the container.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# The secret that signs the login tokens: at least 32 characters, random, never committed.
# Generate one with, for example:  openssl rand -base64 48
# Left commented out on purpose. Running from source (`npm run api`) uses a clearly fake key from
# appsettings.Development.json, and docker-compose.yml falls back to the same fake key, so a clean
# checkout starts without this. Uncomment and set it to override that key, and in any real
# deployment, where it is the only source of the key. (A value that is too short, such as
# "replace-me", stops the API at startup, so do not leave a placeholder here.)
# Jwt__Key=

# Development turns on Swagger, the automatic migration and the demo seed data. docker-compose.yml
# passes this to the api container (Development when unset). Production turns all three off, which
# is the right setting for a real deployment, where migrations are run as a separate step (see the
# Docker section of README.md).
ASPNETCORE_ENVIRONMENT=Development
